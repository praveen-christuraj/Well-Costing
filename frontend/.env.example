# Local Nuxt development. Never expose backend or database secrets with NUXT_PUBLIC_*.
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000
# Render Free can require about a minute to wake after idle spin-down.
NUXT_API_PROXY_TIMEOUT_MS=90000

# ── Termux (Android phone) deployment ─────────────────────────────────────────
# Copy the block below into frontend/.env when deploying on Termux.
# Replace <LAN_IP> with your phone's Wi-Fi IP (run `ip addr` in Termux to find it).
# NUXT_PUBLIC_API_BASE=/api/v1
# NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000
# NUXT_API_PROXY_TIMEOUT_MS=30000
# HOST=0.0.0.0
