# ── Frontend environment variables (never commit .env) ─────────────────────────
# These are read by Nuxt at build and runtime.

# Public API prefix — must match backend API_V1_PREFIX
NUXT_PUBLIC_API_BASE=/api/v1

# Internal API base URL (server-side proxy target)
# Local: http://127.0.0.1:8000
# Render: https://<your-render-service>.onrender.com
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000

# Server proxy timeout in milliseconds
# Use 90000 for Render Free (cold starts may take ~60s)
NUXT_API_PROXY_TIMEOUT_MS=30000

# Bind host (use 0.0.0.0 to allow LAN access)
HOST=0.0.0.0

# Mark the auth token cookie with the Secure attribute (default: on for
# production builds). Set to 'false' when accessing the app over plain HTTP
# from another device on the network (http://192.168.x.x:3000) — browsers
# silently drop Secure cookies on non-localhost HTTP origins, which shows
# up as "Authentication is required" on save. Keep 'true' for HTTPS.
NUXT_PUBLIC_SECURE_COOKIE=false