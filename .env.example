# Copy this file to backend/.env for local backend development.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://drilling_costing:replace_with_local_password@localhost:5432/drilling_costing
# Optional direct URL for hosted migrations; defaults to DATABASE_URL locally.
MIGRATION_DATABASE_URL=
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0

# Place these values in frontend/.env only when overriding Nuxt defaults locally.
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000
NUXT_API_PROXY_TIMEOUT_MS=90000
