# ── Local backend development. Never commit backend/.env. ───────────────────
ENVIRONMENT=development
# Special characters in the password must be percent-encoded in the URL
# ('%' -> '%25', '@' -> '%40', '/' -> '%2F'). Migrations handle the encoded
# form safely; a literal unencoded '%' will not parse as part of the password.
DATABASE_URL=postgresql+psycopg://drilling_costing:replace_with_local_password@localhost:5432/drilling_costing
# Optional direct URL for hosted migrations; defaults to DATABASE_URL locally.
MIGRATION_DATABASE_URL=
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0
# In development/termux the backend applies pending migrations on startup so a
# pulled update can never leave the local database behind the code. Set to
# false to manage migrations manually with `alembic upgrade head`.
# AUTO_MIGRATE=true

# ── Supabase Auth (optional) ──────────────────────────────────────────────────
# Unset by default: users sign in with the password hash stored in the app's own
# users table. To also let users created in Supabase Authentication sign in, set
# both SUPABASE_URL and an API key (anon/public is enough for sign-in):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<project settings → API → anon public key>
# SUPABASE_SERVICE_ROLE_KEY=<optional; used only when SUPABASE_ANON_KEY is absent>

# ── Cloud deployment (Vercel + Render + Neon) ─────────────────────────────────
# ENVIRONMENT=uat
# DATABASE_URL=postgresql+psycopg://<neon-pooled-url>
# MIGRATION_DATABASE_URL=postgresql+psycopg://<neon-direct-url>
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(48))">
# CORS_ORIGINS=["https://<your-vercel-domain>.vercel.app"]
# LOG_LEVEL=INFO
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# API_V1_PREFIX=/api/v1
# APP_VERSION=0.1.0-uat

# ── Termux (Android phone) deployment — Supabase database ─────────────────────
# setup.sh generates backend/.env automatically. Manual reference:
# Supabase URL: project → Settings → Database → Connection string → URI
# Use the Transaction pooler URL (port 6543) for mobile connections.
# Replace <LAN_IP> with your phone's Wi-Fi IP (run `ip addr` in Termux).
# ENVIRONMENT=termux
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
# CORS_ORIGINS=["http://localhost:3000","http://<LAN_IP>:3000"]
# LOG_LEVEL=INFO
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# API_V1_PREFIX=/api/v1
# APP_VERSION=0.1.0

# ── Local deployment with SQLite (development only, limited compatibility) ─────
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./dev.db
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=INFO
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# API_V1_PREFIX=/api/v1
# APP_VERSION=0.1.0
